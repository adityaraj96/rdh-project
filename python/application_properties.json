[
  {
    "PropertyGroupId": "kinesis.analytics.flink.run.options",
    "PropertyMap": {
      "python": "main.py",
      "jarfile": "lib/rdh-couchbase-sink.jar"
    }
  },
  {
    "PropertyGroupId": "KafkaSource",
    "PropertyMap": {
      "bootstrap.servers": "b-1.msk.xxxxxx.kafka.us-east-1.amazonaws.com:9098",
      "topics": "mms.INVMST,mms.INVPRC,mms.INVUPC",
      "group.id": "rdh-item-master",
      "security.protocol": "SASL_SSL"
    }
  },
  {
    "PropertyGroupId": "CouchbaseSink",
    "PropertyMap": {
      "connection.string": "couchbases://cb.xxxxxxxx.cloud.couchbase.com",
      "username": "rdh_writer",
      "password": "CHANGE_ME",
      "bucket": "rdh_ods",
      "scope": "item",
      "collection": "item_master",
      "batch.size": "500",
      "linger.ms": "200",
      "max.concurrency": "128",
      "kv.timeout.ms": "2500"
    }
  },
  {
    "PropertyGroupId": "Job",
    "PropertyMap": {
      "bundle.time.ms": "100",
      "bundle.size": "1000"
    }
  }
]